# pdf-extractext-api — variables de entorno
# Copiar a .env y ajustar valores. El proceso no lee .env por sí solo
# (lo hace el entorno o el runner de Docker/compose), la config se
# valida al arranque con fail-fast.

# Puerto de escucha. Formato net/http: CON dos puntos iniciales.
PORT=:3000

# URL base del microservicio de extracción (OBLIGATORIA).
# Valor para la red `services` del compose de pdf-extractext-infrastructure:
EXTRACTION_URL=http://extraction:8001

# URL base del microservicio de persistencia (OBLIGATORIA al arranque,
# aún sin consumo en el código — el cliente HTTP llega con la issue #6).
PERSISTENCE_URL=http://persistence:8002

# Límite duro del cuerpo HTTP en megabytes (default 20).
# Aplica al multipart COMPLETO (fronteras + headers + archivo).
MAX_FILE_SIZE_MB=20
