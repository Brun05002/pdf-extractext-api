# pdf-extractext-api — variables de entorno
# Copiar a .env y ajustar valores. El proceso no lee .env por sí solo
# (lo hace el entorno o el runner de Docker/compose), la config se
# valida al arranque con fail-fast.

# Puerto único de escucha y registro en Consul (acepta 8000 o :8000).
PORT=:8000

# URL base del microservicio de extracción.
# Ruta principal del stack: entrypoint interno de Traefik (:8090); el Host
# header lo fija el cliente HTTP. Default: http://traefik:8090.
EXTRACTION_URL=http://traefik:8090
# Solo para smoke aislado SIN Traefik: EXTRACTION_URL=http://extraction:8001

# Host header que el router interno de Traefik usa para enrutar a Extraction.
# Default: extraction.pdf-extractext.localhost.
EXTRACTION_HOST=extraction.pdf-extractext.localhost

# URL base del microservicio de persistencia (router interno de Traefik :8090).
# La consumen POST /upload-pdf y el CRUD /documents. Default: http://traefik:8090.
PERSISTENCE_URL=http://traefik:8090
# Host header para el router interno de Traefik. Default: persistence.pdf-extractext.localhost.
PERSISTENCE_HOST=persistence.pdf-extractext.localhost

# Límite duro del cuerpo HTTP en megabytes (default 16).
# Aplica al multipart COMPLETO (fronteras + headers + archivo).
MAX_FILE_SIZE_MB=16

# --- Integración con HashiCorp Consul ---
# Habilitar registro, health gate y lectura de KV (default: false).
CONSUL_ENABLED=false
# Dirección HTTP del agente Consul (default: http://consul:8500).
CONSUL_HTTP_ADDR=http://consul:8500
# Token ACL; se envía en X-Consul-Token en todas las peticiones (vacío = sin ACL).
CONSUL_HTTP_TOKEN=

# Identidad del servicio registrado.
SERVICE_NAME=pdf-extractext-api
SERVICE_HEALTH_PATH=/

# Health gate: TTL del caché en memoria y comportamiento ante caída de Consul.
CONSUL_HEALTH_CACHE_TTL=3s
CONSUL_HEALTH_FAIL_OPEN=true

# Configuración remota (solo con CONSUL_ENABLED=true):
# se lee de pdf-extractext/config/api/ y aplica EXTRACTION_URL, EXTRACTION_HOST,
# PERSISTENCE_URL, PERSISTENCE_HOST y MAX_FILE_SIZE_MB. Precedencia:
# variable de entorno explícita > KV > default. Nunca se leen secretos desde KV.
